/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Content-Type: audio/mpeg
  Accept-Ranges: bytes

/assets/covers/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/thumbnails/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate
